# app/.env.local.example
#
# Copy this file to app/.env.local and fill in all values.
# This file is safe to commit; .env.local is gitignored.

# ── Database, when you run setup/dev FROM YOUR MACHINE ───────────────────────
# `env.example` sets DATABASE_URL with host `@db:` -- that name only resolves
# INSIDE Docker Compose. When you run `npm run setup` / `npm run dev` from your
# machine (the Quick Start path), the database is reachable at localhost on the
# mapped port -- 5433 for the default `db` service (docker-compose.yml). setup.sh
# reads THIS file's DATABASE_URL first, so the line below is what makes a
# host-side run work; use the same POSTGRES_USER/POSTGRES_PASSWORD you set in
# `.env`. Inside a Compose container the container's own DATABASE_URL env var
# wins over this file, so leaving it set does no harm there.
DATABASE_URL=postgresql://dbuser_fbc:your-password-here@localhost:5433/holt_demo?connection_limit=20&pool_timeout=10

# ── Google OAuth (NextAuth) ──────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/ → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── REQUIRED to boot ─────────────────────────────────────────────────────────
# Encrypts IntegrationCredential at rest. The app REFUSES TO START without it
# (lib/validateEnv.ts requires >= 16 chars). Generate with:
#   openssl rand -base64 32
# Losing or changing this makes every stored integration credential
# undecryptable -- back it up with your secrets, not with the code.
APP_ENCRYPTION_KEY=

# ── REQUIRED to log in locally ───────────────────────────────────────────────
# Registers the email/password auth provider. Without it only Google OAuth is
# available, and the staff accounts created by `npm run seed:demo` cannot sign
# in at all. Leave it off in production if you use SSO.
AUTH_LOCAL_ENABLED=true

# ── NextAuth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Public URL of the app (no trailing slash).
# In production this MUST be https:// -- secure cookies depend on it and
# validateEnv enforces it. http://localhost:3000 is fine for local dev.
NEXTAUTH_URL=http://localhost:3000

# ── Gmail API (automated report ingestion) ───────────────────────────
# Path to the Google Workspace service account JSON file (mounted as Docker volume)
GMAIL_SERVICE_ACCOUNT_PATH=/app/config/service-account.json
# Google Workspace user to impersonate via domain-wide delegation
GMAIL_IMPERSONATE_EMAIL=you@example.com
# Secret used to authenticate cron-triggered import calls
AUTO_IMPORT_API_KEY=

# ── GitHub App (in-app feedback → GitHub Issues) ─────────────────────────────
# Create a GitHub App at https://github.com/settings/apps
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
...
-----END RSA PRIVATE KEY-----"
GITHUB_INSTALLATION_ID=

# ── FileMaker Data API ────────────────────────────────────────────────────────
FM_API_BASE=
FM_USERNAME=
FM_PASSWORD=

# ── Mailchimp ─────────────────────────────────────────────────────────────────
MAILCHIMP_API_KEY=

# ── Axper (store traffic) ─────────────────────────────────────────────────────
NEXT_PUBLIC_AXPER_API_URL=https://api.axper.com/v1
AXPER_API_KEY=

# ── PBX / Phone System ────────────────────────────────────────────────────────
PBX_API_URL=
PBX_API_TOKEN_URL=
PBX_API_CLIENT_ID=
PBX_API_CLIENT_SECRET=

# ── MDM (Mobile Device Management) ───────────────────────────────────────────
MDM_KEY=

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional per-deployment web-font stylesheet (e.g. an Adobe Typekit kit URL).
# Omitted entirely when unset -> system/web-safe fonts. Each deploy sets its OWN.
NEXT_PUBLIC_FONT_CSS_URL=

# Set to "true" only when the app sits behind a single trusted reverse proxy
# (e.g. nginx). Lets the rate limiter trust that proxy's X-Real-IP, else its
# appended X-Forwarded-For hop. Leave unset when the app is reachable directly:
# both headers are then client-spoofable and ignored, and the socket peer is used.
TRUST_PROXY=
